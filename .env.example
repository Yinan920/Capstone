# SellerSense backend configuration.
# Copy to .env and adjust. Every value has a working default — the app runs
# end-to-end with ZERO real API keys (all AI providers default to mocks).

# --- Database -----------------------------------------------------------
# Docker Compose default. For Homebrew Postgres, point at your local server,
# e.g. postgresql+asyncpg://localhost:5432/sellersense
DATABASE_URL=postgresql+asyncpg://sellersense:sellersense@localhost:5432/sellersense

# --- Auth ---------------------------------------------------------------
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_MINUTES=1440

# --- Tier gating --------------------------------------------------------
FREE_REVIEW_CAP=50
PREMIUM_REVIEW_CAP=200

# --- AI providers (adapters) -------------------------------------------
# LLM_PROVIDER: mock | anthropic  (anthropic requires ANTHROPIC_API_KEY)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# EMBEDDINGS_PROVIDER: mock | st  (st = local sentence-transformers, no key
# needed but downloads the all-MiniLM-L6-v2 model on first run)
EMBEDDINGS_PROVIDER=mock
# In-flight LLM requests per pipeline stage. 8 is measured-best for a single
# analysis (docs/benchmarks.md); lower it if concurrent uploads hit rate limits.
SENTIMENT_CONCURRENCY=8
THEME_LABEL_CONCURRENCY=8

# --- Alert rule engine --------------------------------------------------
ALERT_THRESHOLD=0.15

# --- CORS (frontend dev server) ----------------------------------------
CORS_ORIGINS=http://localhost:5173
