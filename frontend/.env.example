# SellerSense frontend configuration
#
# The app ships in "mock mode" — all data comes from local fixtures and it runs
# with zero backend. To point it at the real FastAPI backend later:
#   1. set VITE_USE_MOCKS=false
#   2. set VITE_API_BASE_URL to the backend URL
# No component code changes are needed — only src/lib/api.ts switches source.

VITE_USE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8000/api
